/// Use case: to bridge the Catch Fact Table with the Year Dim.
/// 
table Dim_Year_Bridge
	lineageTag: 8958afc7-d45f-4b04-ab42-23bc7e2c7c7b

	column Year
		formatString: 0
		lineageTag: 0149e8c7-3267-402d-834f-8f2719b97a48
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	partition Dim_Year_Bridge = calculated
		mode: import
		source = DISTINCT(SELECTCOLUMNS(Dim_Date, "Year", Dim_Date[Year]))

	annotation PBI_Id = 0bbdc737bad84c26a379b1cbd3947c97


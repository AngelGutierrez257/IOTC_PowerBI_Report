	measure 'Fishing Effort' = sum(Fishing_Effort_Model[EFFORT])
		lineageTag: 44f227cc-a363-47fd-8bad-302c2885918c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '90 Percentile Fleets by Catch' = PERCENTILEX.INC(SUMMARIZE(Catch_Estimates_Model,Catch_Estimates_Model[Fleet Code],Catch_Estimates_Model[Year]),[Catch in Tons],0.9)
		lineageTag: 63c0105e-153c-44a1-8dbd-b57b78e75780

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catch StandardDev' = STDEV.P(Catch_Estimates_Model[Catch Weight])
		lineageTag: 15a69f7a-4657-49f8-aa40-39e0a151df37

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catch Outliers' = if([Catch in Tons] > [90 Percentile Fleets by Catch], "90 Percentile","Below 90 Percentile")
		lineageTag: 745823c8-6272-4a54-a2b9-54a030ee0de9

	measure 'BET Quota Adj Catch Forecast' = CALCULATE([Catch in Tons]*(1-'Quota Reduction'[Quota Reduction Value] / 100), Dim_Species[Species Code] = "BET")
		lineageTag: fa233c29-c1ac-4a8b-97fe-b3c9dbe52b11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'BET Quota Adj Revenue Forecast' = [BET Quota Adj Catch Forecast] * [BET Avg Price]
		lineageTag: 7d187174-d6f4-4bc0-8556-3be5a4758b54

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'BET Quota Adj Revenue Impact' = [BET Quota Adj Revenue Forecast]-([Catch in Tons]*[BET Avg Price])
		lineageTag: 08aa00ef-2b91-429e-94b7-061a37c87759

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		formatString: 0
		lineageTag: 2b4c76a8-59e0-4f5d-9181-0dfc39b5c587
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import

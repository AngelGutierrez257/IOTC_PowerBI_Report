table _Measures
	lineageTag: 5b9647cf-142f-4497-aecb-d3b8002ec75a

	measure 'Catch in Tons' = DIVIDE(SUM(Catch_Estimates_Model[Catch Weight]),1000,0)
		formatString: 0
		lineageTag: 2d27aa59-7a12-4377-a983-69b5def95d9d

	measure 'Total Catches' = CALCULATE([Catch in Tons],  REMOVEFILTERS())
		lineageTag: 3c85d246-f05a-4d49-8f10-166c1aaa0bf6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Catch' = DIVIDE([Catch in Tons], [Total Catches],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f2efec2b-e2ff-4b9c-be00-5fb8b86b50e5

	measure 'Total Catches by Species' = CALCULATE(sum(Catch_Estimates_Model[Catch Weight]) / 1000, REMOVEFILTERS((Dim_Species)))
		lineageTag: 8ed2dce2-6ccb-468a-97e8-c5af4a6f8ee3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rank Species Catches' = ```
			IF(ISINSCOPE(Dim_Species[Species Code]), RANKX(ALLSELECTED(Dim_Species[Species Code]), [Catch in Tons],,DESC,Dense)) 
			/*ISINSCOPE ensures that rankx only runs if row has a valid species code.*/
			```
		formatString: 0
		lineageTag: e2e0a02e-9a54-4b46-864c-50a68502249e

	measure 'Rank Fleet Catches' = RANKX(All(Dim_Fleet),[Catch in Tons],,DESC,Dense)
		formatString: 0
		lineageTag: 12262cf6-15d3-43e3-8da4-c074b9ef7c81

	measure 'Total Catches by Fleet' = CALCULATE(sum(Catch_Estimates_Model[Catch Weight]) / 1000, REMOVEFILTERS((Dim_Fleet)))
		lineageTag: 6a42f986-fe87-45e0-a68e-1459bdf5d5d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Effort' = CALCULATE(sum(Fishing_Effort_Model[EFFORT]), REMOVEFILTERS())
		lineageTag: cd56bca0-2ae3-4653-944f-0a46fd4564ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Species Catch' = DIVIDE([Catch in Tons], CALCULATE([Total Catches], REMOVEFILTERS(Dim_Species)),0)
		lineageTag: 4a6ee378-0812-47a1-a919-6e90e575f878

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Catch by Fleet' = DIVIDE([Catch in Tons], CALCULATE([Total Catches], REMOVEFILTERS(Dim_Fleet)),0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a5ebfce-47d0-44cf-bce4-0554d39e831a

	measure 'Total Effort by Fleets' = CALCULATE(SUM(Fishing_Effort_Model[EFFORT]), REMOVEFILTERS(Dim_Fleet))
		lineageTag: 41b0690d-e738-43e4-b490-e2852e779494

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Catches by Gear' = CALCULATE(sum(Catch_Estimates_Model[Catch Weight]), REMOVEFILTERS('Dim_Fisheries&Gear'[Gear FAO Code]))
		lineageTag: 0188327e-3e27-4819-bf82-cfafb0707a17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Catch by Gear' = DIVIDE([Catch in Tons], CALCULATE([Total Catches], REMOVEFILTERS('Dim_Fisheries&Gear'[Gear FAO Code])),0)
		formatString: 0%;-0%;0%
		lineageTag: 6e7e2554-3bc1-4162-9dc2-26e20b816349

	measure 'Rank Gear Catches' = RANKX(ALLSELECTED('Dim_Fisheries&Gear'[Gear FAO Code]),[Catch in Tons],,DESC,Dense)
		formatString: 0
		lineageTag: 7d7140ee-b122-48ad-9cca-57898c934d04

	measure 'Avg Import Price by Species' = DIVIDE(SUMX(Dim_Species, AVERAGE(Tuna_Import_Prices[Price per kg]) * 1000 * [Catch in Tons]), [Catch in Tons],0)
		lineageTag: a06957ec-02c4-4529-90d1-c97e2e12bd7d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catch Value by Species' = sumx(Dim_Species, AVERAGE(Tuna_Import_Prices[Price per kg])*1000*[Catch in Tons])
		lineageTag: dc264bc4-5a76-48e7-9264-42d2980ef0f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catches YTD' = TOTALYTD([Catch in Tons], Dim_Date[Date])
		lineageTag: 3be7e5f8-95fd-4035-bc75-1d1a70098184

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catches YoY Evolution' = VAR CurrentYear = [Catch in Tons] VAR PriorYear = CALCULATE([Catch in Tons], SAMEPERIODLASTYEAR(Dim_Date[Date])) return DIVIDE(CurrentYear-PriorYear, PriorYear)
		lineageTag: 2cc24e51-6755-4807-a747-c89c09baff09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catch  Running Total per Gear' = var Gear = SELECTEDVALUE('Dim_Fisheries&Gear'[Gear]) RETURN CALCULATE([Catch in Tons],'Dim_Fisheries&Gear'[Gear] >= Gear, ALL('Dim_Fisheries&Gear'[Gear]))
		lineageTag: 973a51b5-affa-4d36-a169-4602bfc4b8cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catch  Running Total per Species' = var SpeciesCat = SELECTEDVALUE('Dim_Species'[Species Name]) RETURN CALCULATE([Catch in Tons],Dim_Species[Species Name] >= SpeciesCat, ALL(Dim_Species[Species Name]))
		lineageTag: ab7123a5-f7e8-4ce2-b222-44cc40d09b04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catch Running total' =
			CALCULATE(
			    SUM(Catch_Estimates_Model[Catch Weight]),
			    FILTER(
			        ALLSELECTED('Dim_Year_Bridge'[Year]),
			        'Dim_Year_Bridge'[Year] <= MAX('Dim_Year_Bridge'[Year])
			    )
			)
		lineageTag: 3c9b392c-e047-4d98-85b0-4fe511af53c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LL & PS Fleet Cost Index' = var LL_BaseRate_per1000hooks = 50 var PS_BaseRate_perSet = 1500 var Multiplier = [FuelPriceMultiplier Value] var LL_Hooks = calculate(SUM(Fishing_Effort_Model[EFFORT]), Fishing_Effort_Model[EFFORT_UNIT_CODE] = "HOOKS") var LL_Costs = (LL_Hooks/1000)*LL_BaseRate_per1000hooks*Multiplier Var PS_Sets = calculate(SUM(Fishing_Effort_Model[EFFORT]), Fishing_Effort_Model[EFFORT_UNIT_CODE] = "SETS") var PS_Costs = PS_Sets*PS_BaseRate_perSet*Multiplier return SWITCH(TRUE(), SELECTEDVALUE('Dim_Fisheries&Gear'[Fishery Group Code]) = "LL", LL_Costs, SELECTEDVALUE('Dim_Fisheries&Gear'[Fishery Group Code]) = "PS", PS_Costs, LL_Costs+PS_Costs)
		formatString: 0
		lineageTag: 3e1c4737-c760-4d99-9260-e8d191522dad

	measure 'Fuel Adj Margin' = var totalrevenue = [Total Catches] * 1500 var TotalCost = [LL & PS Fleet Cost Index] return divide(totalrevenue-TotalCost, totalrevenue)
		lineageTag: ad361e57-815f-40f3-ac6d-a25cc1ecb3e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TOP 10 Fleet by Catch' = CALCULATE([Catch in Tons], TOPN(10,VALUES(Dim_Fleet[Fleet Code]),[Catch in Tons],DESC))
		lineageTag: 913155e5-9452-4a4c-b8c6-03c59ff87c45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TOP 10 Fleet by LL Effort' = CALCULATE([Catch in Tons], TOPN(10,SUMMARIZE(Fishing_Effort_Model,Fishing_Effort_Model[FLEET_CODE],Fishing_Effort_Model[YEAR]),[Catch Per Unit Effort Longline]))

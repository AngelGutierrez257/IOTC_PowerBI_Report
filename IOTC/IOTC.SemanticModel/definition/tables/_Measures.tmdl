	measure 'Catch Per Unit Effort Longline' = var Catch = CALCULATE(sum(Catch_Estimates_Model[Catch Weight]), 'Dim_Fisheries&Gear'[Fishery Group Code] = "LL") var Effort = CALCULATE(sum(Fishing_Effort_Model[EFFORT]), 'Dim_Fisheries&Gear'[Fishery Group Code] = "LL", Fishing_Effort_Model[EFFORT_UNIT_CODE] = "HOOKS") return DIVIDE(Catch,Effort/1000, BLANK())
		formatString: 0.000
